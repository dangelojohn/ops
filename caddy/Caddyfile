{
    auto_https off
}

(alfacore_routes) {
    handle_path /git/* {
        reverse_proxy forgejo:3000
    }
    handle_path /git/* {
        reverse_proxy forgejo:3000
    }
    @longpoll path /longpolling/* /websocket
    handle @longpoll {
        reverse_proxy odoo:8072
    }
    handle {
        reverse_proxy odoo:8069 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }
    encode gzip
    request_body {
        max_size 100MB
    }
}

