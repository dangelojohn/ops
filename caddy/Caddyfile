www.southbrookcabinetry.local:80, southbrookcabinetry.local:80 {
    import southbrook_routes
}
www.southbrookcabinetry.local:443, southbrookcabinetry.local:443 {
    tls /data/caddy/certs/southbrook.crt /data/caddy/certs/southbrook.key
    import southbrook_routes
}

